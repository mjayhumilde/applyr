# Vercel deployment settings only. Local Vite uses its existing /api proxy.
# Set these in the WEB project's Vercel environment variables.
# Never prefix these variables with VITE_: they must stay out of browser code.

# Backend project's actual production origin (not the web project's domain).
API_ORIGIN=https://your-api-project.vercel.app

# Generate a random secret of at least 32 printable, non-space characters.
# Set the SAME secret on the web and server Vercel projects. Keep it out of Git.
PROXY_SHARED_SECRET=replace-with-a-new-random-secret
