DATABASE_URL=postgresql://applyr_app:YOUR_PASSWORD@localhost:5432/job_tracker
PORT=3000
NODE_ENV=development
DB_POOL_MAX=5

# Local Google authentication (server only; never use VITE_ for secrets).
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Generate a random secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Create a Google OAuth client with application type "Web application".
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production Vercel settings (set in the dashboard, not in browser code):
# NODE_ENV=production
# DATABASE_URL=postgresql://applyr_app:ENCODED_PASSWORD@YOUR_POOLED_NEON_HOST/neondb?sslmode=verify-full
# BETTER_AUTH_URL=https://YOUR_FRONTEND_DOMAIN
# WEB_ORIGIN=https://YOUR_FRONTEND_DOMAIN
# PROXY_SHARED_SECRET=<a separate random secret, at least 32 characters>
# Set this SAME proxy secret on the web project. Do not reuse BETTER_AUTH_SECRET.
# VERCEL=1 is supplied by Vercel itself; do not set it for local development.
